# ---------------------------------------------------------------------------
# Blueprint Academy — variables d'environnement
# Copier en `.env` a la racine : cp .env.example .env
# Ne JAMAIS commiter le fichier .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=blueprint
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=blueprint
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Port PostgreSQL expose sur la machine hote (l'interieur du reseau Docker
# reste sur 5432). A changer si le port est deja pris par une autre instance.
POSTGRES_HOST_PORT=5434

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS / CSRF (frontend autorise a appeler l'API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT (refresh token en cookie httpOnly) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=bp_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax

# --- Frontend ---
# URL de l'API vue depuis le NAVIGATEUR
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# URL de l'API vue depuis le CONTENEUR frontend (SSR / server components)
INTERNAL_API_URL=http://backend:8000/api
