# Planning de l'équipe d'agents — à installer avec : crontab -e
# Remplace CHEMIN par le chemin absolu du dépôt (ex. /home/gael/Blueprint_Academy).
# Heures = heure locale de l'ordinateur (Abidjan, UTC+0).
# L'ordinateur doit être allumé et connecté à ces heures.

NTFY_TOPIC=remplace-par-un-sujet-secret

# Historique : l'équipe tourne désormais sur GitHub (docs/equipe-cloud.md). N'installe ce planning
# que si tu veux la faire tourner sur ton ordinateur à la place (jamais les deux à la fois).

# Dimanche 19 h : pilotage de l'organisateur (bilan, estimation, plan, rapport PDF)
0 19 * * 0  CHEMIN/scripts/cycle.sh pilotage >> CHEMIN/logs/cron.log 2>&1

# Chaque soir 21 h 05 : une équipe de nuit (créneaux enchaînés ; Docker doit pouvoir démarrer)
5 21 * * *  CHEMIN/scripts/cycle.sh nuit >> CHEMIN/logs/cron.log 2>&1

# Chaque matin 7 h 40 : rapport de la nuit dans le bureau de l'organisateur
40 7 * * *  CHEMIN/scripts/cycle.sh matin >> CHEMIN/logs/cron.log 2>&1
