{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose exec -T backend pytest)",
      "Bash(docker compose exec -T backend pytest *)",
      "Bash(docker compose exec -T backend ruff *)",
      "Bash(docker compose exec -T backend python manage.py makemigrations *)",
      "Bash(docker compose exec -T backend python manage.py migrate)",
      "Bash(docker compose exec -T backend python manage.py migrate *)",
      "Bash(docker compose exec -T backend python manage.py check)",
      "Bash(docker compose exec -T backend python manage.py check *)",
      "Bash(docker compose exec -T backend python manage.py showmigrations *)",
      "Bash(docker compose exec -T backend pip install -r requirements-dev.txt)",
      "Bash(docker compose exec -T frontend npm install)",
      "Bash(docker compose exec -T frontend npm install --package-lock-only)",
      "Bash(docker compose exec -T frontend npm install -D *)",
      "Bash(docker compose exec -T frontend npm run typecheck)",
      "Bash(docker compose exec -T frontend npm run lint)",
      "Bash(docker compose exec -T frontend npm run lint *)",
      "Bash(docker compose exec -T frontend npm test)",
      "Bash(docker compose exec -T frontend npm test *)",
      "Bash(docker compose exec -T frontend npm audit)",
      "Bash(docker compose exec -T frontend npm audit *)",
      "Bash(docker compose exec -T frontend npx eslint *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)",
      "Bash(git grep *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git push)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checkout *)",
      "Bash(python3 scripts/captures.py *)",
      "Bash(gh pr list)",
      "Bash(gh issue list)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./docker-compose.yml)",
      "Bash(docker compose down *)",
      "Bash(docker volume *)",
      "Bash(docker system *)",
      "Bash(docker compose exec -T backend python manage.py flush *)",
      "Bash(docker compose exec -T backend python manage.py shell *)",
      "Bash(git push origin master *)",
      "Bash(git push * master)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(./scripts/**)",
      "Edit(./outils/**)",
      "Bash(gh release *)",
      "Bash(gh pr edit * --add-label a-valider-ange*)",
      "Bash(gh pr edit * --remove-label a-valider-ange*)",
      "Bash(gh issue edit * --remove-label point-hebdo*)",
      "Bash(gh issue edit * --remove-label bureau*)",
      "Bash(gh issue edit * --add-label bureau*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git config *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/controleur.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
